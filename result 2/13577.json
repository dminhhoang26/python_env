      "reviewList": [
        {
          "additionText": "",
          "age": "1991",
          "atopy": false,
          "badText": "아쉬운 점은 딱히 없어요. 같은 브랜드 리브인 트리트먼트 쓰는데 향이 서로 달라서 굳이 뽑자면 그부분이에요.",
          "blind": 0,
          "brand": "레이티드그린 (RATEDGREEN)",
          "commentCount": 0,
          "encryptedProductId": "1809a680712ef864715c39cdbeb9205b",
          "gender": "여성",
          "goodText": "향도 좋고 머릿결이 부드러워지는 느낌이에요.",
          "images": [],
          "isActiveUser": true,
