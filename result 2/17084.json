      "reviewList": [
        {
          "additionText": "비비크림으로 쓰지말고 프라이머처럼 모공부분에 동글동글 굴려가면서 매꿔보세요",
          "age": "1994",
          "atopy": false,
          "badText": "아쉬운점은 가격입니다ㅠㅠㅠ 가격이 넘넘 비싸유흑 좀만 더 세일해줬으면..",
          "blind": 0,
          "brand": "미구하라 (MIGUHARA)",
          "commentCount": 0,
          "encryptedProductId": "dffa25035a1cc4e79e72ebbf93173337",
          "gender": "여성",
          "goodText": "두통 이상 쓴 제품. 이건 비비나 파운데이션 대용으로 쓰면 안되고, 프라이머 대용으로 써야합니다.\n그런데 성분 리뉴얼되기전 (거의 8-9년 된듯?) 효과가 진짜 미치게 좋았는데 성분을 좀더 좋게 리뉴얼하면서 이전만큼의 모공 블러효과가 좀 떨어졌어요. 진짜 처음에 나왔을때 그 제품이 진짜 미친 모공 커버력이었는데 아쉽,,,\n그치만 리뉴얼 후 버전도 진짜 좋습니다. 거의 시중에 나온  모공 프라이머 대부분 다써봤는데 탑3안에 들어요.",
          "images": [],
          "isActiveUser": true,
          "isAdmin": false,
          "isAdvertising": false,
          "isCheckingReview": false,
          "isFollowed": false,
          "isLiked": false,
          "isScrapped": false,
          "likeCount": 0,
          "modifyTime": 1727861923,
          "productImageUrl": "https://img.hwahae.co.kr/products/1903152/1903152_20230410100118.jpg",
          "productIndex": 1903152,
          "productName": "라이트 벨벳 비피크림 오리진",
          "rating": 5,
          "repurchase": -1,
          "reviewId": 9387774,
