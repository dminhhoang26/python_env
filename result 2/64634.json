        {
          "additionText": "",
          "age": "1993",
          "atopy": false,
          "badText": "굳이 꼽자면 제형이 묽다는 거? 촉촉하게 관리하시는 편이면 이거 외에 에센스 하나 추가하시는 게 좋을 것 같아용",
          "blind": 0,
          "brand": "토니모리 (TONYMOLY)",
          "commentCount": 0,
          "encryptedProductId": "6c8bd0c6016daa0eb553b6306f1a0a90",
